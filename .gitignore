# Python
__pycache__/
*.pyc

# Secrets and local env
.env
.env.*
*.pem

# OS / editor
.DS_Store

# Large or generated artifacts kept locally, not in history
archive/_w3d/
archive/trajectory-*.json

# Live-coach session logs (local runs, may hold learner data)
archive/livecoach/runs/

# Synthetic test rounds (regenerate with: python3 -m chef bots)
archive/gameplay/synthetic/

# Downloads and derived inputs (python3 -m coach.data.fetch): weights, videos, vendored repos, predictions
data/

# Run outputs and rendered videos (written by the notebook)
results/

# Demo site: the page and its icons are tracked; its data and media are built from results/
site/*
!site/index.html
!site/icons/

# demo video: local media, research downloads, renders
video/research/
video/media/
video/audio/
video/out/
video/.venv/
node_modules/
