# Python
__pycache__/
*.pyc

# Secrets and local env
.env
.env.*
*.pem

# OS / editor
.DS_Store

# Large or generated artifacts kept locally, not in history
_w3d/
trajectory-*.json

# Live-coach session logs (local runs, may hold learner data)
livecoach/runs/

# Synthetic test rounds (regenerate with: python3 -m chef bots)
gameplay/synthetic/

# V-JEPA 2 / EPIC-KITCHENS cache: weights, videos, vendored repos (python3 -m jepa.fetch)
jepa/_cache/

# Demo page media and data (python3 -m jepa.build_demo); only the page itself is tracked
jepa/demo/*
!jepa/demo/index.html
